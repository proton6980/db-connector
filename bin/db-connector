#!/bin/bash
#===============================================================================
# db-connector — MCP SSE Server
#
# 启动后监听 http://127.0.0.1:63306，MCP 客户端连接 /mcp endpoint。
# 内置 Web 管理控制台可通过 http://127.0.0.1:68080 访问。
#
# 用法示例（Cursor .cursor/mcp.json）:
#   {
#     "mcpServers": {
#       "db-connector": {
#         "url": "http://127.0.0.1:63306/mcp"
#       }
#     }
#   }
#===============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
VERSION="${DB_CONNECTOR_VERSION:-0.2.2}"
JAR_FILE="$PROJECT_DIR/target/db-connector-${VERSION}.jar"

if [ ! -f "$JAR_FILE" ]; then
    echo "[db-connector] JAR not found at $JAR_FILE, building..." >&2
    cd "$PROJECT_DIR"
    if [ -f "./mvnw" ]; then
        ./mvnw package -DskipTests -q >&2
    else
        mvn package -DskipTests -q >&2
    fi
fi

mkdir -p "$PROJECT_DIR/data"

GRAALVM_HOME="${GRAALVM_HOME:-/Users/feiyu/Library/Java/JavaVirtualMachines/graalvm-jdk-25/Contents/Home}"
JAVA_BIN="${GRAALVM_HOME}/bin/java"

if [ -f "$PROJECT_DIR/target/db-connector" ]; then
    exec "$PROJECT_DIR/target/db-connector" 2>"$PROJECT_DIR/data/dbconnector.log"
fi

exec "$JAVA_BIN" -jar "$JAR_FILE" 2>"$PROJECT_DIR/data/dbconnector.log"